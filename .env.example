# Base de données PostgreSQL
# En local avec docker-compose, le hôte est "db" ; en dev hors Docker, "localhost".
DATABASE_URL="postgresql://agrownuts:agrownuts@localhost:5432/agrownuts?schema=public"

# Secret de session Auth.js — générez-en un avec : openssl rand -base64 32
AUTH_SECRET="remplacez-moi-par-un-secret-aleatoire"

# URL publique de l'application (utile derrière un proxy / en prod)
AUTH_URL="http://localhost:3000"

# Adresse publique utilisée pour le QR code de déclaration (doit être joignable
# depuis les téléphones des chauffeurs). En prod, mettez l'URL du déploiement,
# ex. https://agrownuts.vercel.app  — à défaut, AUTH_URL est utilisé.
APP_URL="http://localhost:3000"

# Compte administrateur créé par le seed (à changer après la première connexion)
SEED_ADMIN_EMAIL="admin@agrownuts.fr"
SEED_ADMIN_PASSWORD="AgroNuts2026!"
SEED_ADMIN_NAME="Hugo"
